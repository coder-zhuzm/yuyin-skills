-<!doctype html><html lang="zh"><head><title>菜单</title></head><body><div onclick="document.querySelector('nav').hidden=false">打开菜单</div><nav hidden><a href="#content">内容</a></nav><main id="content">首页</main></body></html>
+<!doctype html>
+<html lang="zh">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>菜单</title>
+  <style>
+    :root {
+      --color-text: #1f2937;
+      --color-bg: #ffffff;
+      --color-btn-bg: #f9fafb;
+      --color-btn-hover: #f3f4f6;
+      --color-btn-active: #e5e7eb;
+      --color-btn-border: #d1d5db;
+      --color-btn-border-hover: #9ca3af;
+      --color-focus-ring: #2563eb;
+    }
+
+    body {
+      margin: 24px;
+      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
+      color: var(--color-text);
+      background-color: var(--color-bg);
+      line-height: 1.5;
+    }
+
+    .menu-toggle {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      padding: 8px 16px;
+      font-size: 14px;
+      font-weight: 500;
+      color: var(--color-text);
+      background-color: var(--color-btn-bg);
+      border: 1px solid var(--color-btn-border);
+      border-radius: 6px;
+      cursor: pointer;
+      user-select: none;
+      transition: background-color 0.15s ease, border-color 0.15s ease;
+    }
+
+    .menu-toggle:hover {
+      background-color: var(--color-btn-hover);
+      border-color: var(--color-btn-border-hover);
+    }
+
+    .menu-toggle:active {
+      background-color: var(--color-btn-active);
+    }
+
+    .menu-toggle:focus-visible {
+      outline: 2px solid var(--color-focus-ring);
+      outline-offset: 2px;
+    }
+
+    nav {
+      margin-top: 12px;
+    }
+
+    nav a {
+      color: #2563eb;
+      text-decoration: none;
+    }
+
+    nav a:hover {
+      text-decoration: underline;
+    }
+
+    nav a:focus-visible {
+      outline: 2px solid var(--color-focus-ring);
+      outline-offset: 2px;
+      border-radius: 2px;
+    }
+
+    main {
+      margin-top: 16px;
+    }
+  </style>
+</head>
+<body>
+  <button type="button" class="menu-toggle" onclick="document.querySelector('nav').hidden=false">打开菜单</button>
+  <nav hidden><a href="#content">内容</a></nav>
+  <main id="content">首页</main>
+</body>
+</html>
