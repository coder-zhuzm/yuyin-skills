      "vercel-react-best-practices",
      "vercel-composition-patterns"
    ],
    "directSkill": "vercel-react-best-practices",
    "prompt": "给现有商品列表补全筛选：只显示 stock > 0 的有库存商品，输入名称时忽略大小写和两侧空白。保留现有 React 18 和 MUI 组件，完成必要的局部修改与验证。已授权在本隔离项目中实施，不安装依赖。",
    "checks": [
      "scope-preserved",
      "react-filter",
      "react-surface"
    ],
    "expected": [
      "空查询保留所有有库存商品；查询忽略大小写和两侧空白；沿用 React 18 和 MUI"
    ],
    "forbidden": [
      "升级 React",
      "引入 Next.js 或 React 19 API",
      "安装依赖",
      "全站组件重构或新增文档"
    ],
    "allowedChanges": [
      "src/filter-products.mjs",
      "src/ProductList.jsx",
      "*.test.mjs",
      "src/*.test.mjs",
      "src/**/*.test.mjs",
      "tests/**"
    ],
    "baselineFailures": [
      "react-filter"
    ],
    "traceReview": [
      "是否按项目版本选择规则，避免 React 19/Next.js 专属迁移",
      "是否仅修改筛选及必要测试，沿用 MUI 与现有组件结构"
    ],
    "naturalPrompt": "修复商品筛选：只显示有库存的商品，搜索忽略大小写和首尾空格。"
  },
