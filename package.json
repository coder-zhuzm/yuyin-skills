{
  "name": "@zhuzm/yuyin-skills",
  "version": "0.3.2",
  "description": "Curated React, Spring and Node development skills with reproducible upstream snapshots",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coder-zhuzm/yuyin-skills.git"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "files": [
    "skills/development/shared/yuyin-dev/",
    "rules/",
    "templates/",
    "catalog.json",
    "docs/installation.md",
    "docs/development-workflow.md",
    "SOURCES.md",
    "CHANGELOG.md",
    "VERIFICATION.md",
    "THIRD_PARTY_LICENSES/",
    "skills/upstream/",
    "upstream/sources.json",
    "upstream/lock.json"
  ],
  "scripts": {
    "skills": "skills",
    "pack:offline": "npm pack --ignore-scripts",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "upstream:update": "node scripts/upstream.mjs update",
    "upstream:restore": "node scripts/upstream.mjs restore",
    "upstream:check": "node scripts/upstream.mjs check",
    "profiles": "node scripts/profiles.mjs"
  },
  "devDependencies": {
    "skills": "1.7.2",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
